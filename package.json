{
  "name": "zerotrace-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"COLLECTOR,TARGET,AI,FRONTEND\" -c \"blue,yellow,magenta,cyan\" \"npm run dev:collector\" \"npm run dev:target\" \"npm run dev:ai\" \"npm run dev:frontend\"",
    "dev:collector": "npm run dev --workspace=apps/collector",
    "dev:target": "npm run dev --workspace=apps/target-app",
    "dev:ai": "npm run dev --workspace=apps/ai-engine",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build:collector": "npm run build --workspace=apps/collector",
    "build:target": "npm run build --workspace=apps/target-app",
    "build:ai": "npm run build --workspace=apps/ai-engine",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build:all": "npm run build:collector && npm run build:target && npm run build:ai && npm run build:frontend",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}